# This is a source/configuration backup, not a backup of the model data.
# Deny unknown root paths by default; open only the maintained source below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/tests/
!/install/
!/start_model_qwen.ps1
!/start_web_strata.ps1
!/extensions/
/extensions/*
!/extensions/strata-compaction/
!/odd/
/odd/*
!/odd/tasks/
/odd/tasks/*
!/odd/tasks/strata-compaction.md
!/odd/tasks/strata-compaction-reload.md
!/odd/tasks/strata-dedicated-port.md

# Private configuration and key material, even inside allowed directories.
.env
.env.*
auth.json
credentials.json
secrets.*
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx

# Dependencies, generated state and build/test output at any depth.
node_modules/
.venv/
venv/
__pycache__/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.codegraph/
.atl/
.install-state/
.strata-install-backups/
coverage/
dist/
build/
out/
.coverage
*.py[cod]
*.tsbuildinfo
*.log
*.jsonl
*.pid
*.tmp
*.part
*.bak
*.out
*.err
*.db
*.db-*
*.sqlite*
Thumbs.db
.DS_Store

# Model weights, engines and archives must never enter this source repository.
*.gguf
*.safetensors
*.onnx
*.bin
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.zip
*.7z
*.tar
*.gz
